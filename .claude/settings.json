{
  "permissions": {
    "allow": [
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .claude/publicar.ps1 *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude/publicar.ps1 *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PROJECT_DIR\\.claude\\inicio-sesion.ps1\"",
            "timeout": 120,
            "statusMessage": "Trayendo cambios de GitHub y comparando con Google..."
          }
        ]
      }
    ]
  }
}
